# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Generated font cache
src/eda/fonts/*.ttf

# Raw & processed datasets (Proposal Governance: never commit raw data or large binaries)
data/*.zip
data/*.duckdb
data/*.duckdb.wal
data/01_bronze/*
data/02_quarantine/*
data/03_silver/*
data/04_gold/*
!data/**/.gitkeep
!data/checksums_manifest.json

# Generated model binaries, large CSV exports & local HTML with embedded .env API keys
artifacts/models/*.joblib
artifacts/models/*.pkl
artifacts/registry/models/*.joblib
artifacts/registry/models/*.pkl
artifacts/dashboard_index.html
artifacts/evaluation/dashboard_snapshot.json
artifacts/evaluation/latest_24h_forecasts.csv
artifacts/_test_script.js

# Virtual environments & Secret Environment Files
.venv/
venv/
env/
.env
.env.local
.env.*.local
!.env.example
