# ==============================================================================
# Bangkok Traffic Congestion Forecasting (1-Hour Ahead) - Environment Variables
# Course: CSS 342 Data Science and Data Engineering (KMUTT)
# Copy this file to `.env` and fill in your API Keys.
# NEVER commit `.env` with real keys to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Traffic Probe & Spatial GIS APIs (iTIC / Longdo / SerpApi Google Maps)
# Register at: https://map.longdo.com/console/ or https://serpapi.com/manage-api-key
# ------------------------------------------------------------------------------
ITIC_API_KEY=""
ITIC_API_BASE_URL="https://traffic.longdo.com/api/v1"
LONGDO_MAP_API_KEY=""
SERPAPI_API_KEY=""
GOOGLE_MAPS_API_BASE_URL="https://serpapi.com/search?engine=google_maps"

# ------------------------------------------------------------------------------
# 2. Meteorological & Rainfall Observation APIs (TMD / Open-Meteo)
# TMD Portal: https://data.tmd.go.th/nwpapi/doc/
# Open-Meteo: https://open-meteo.com/en/docs (Free tier requires no key)
# ------------------------------------------------------------------------------
TMD_API_UID=""
TMD_API_KEY=""
TMD_API_BASE_URL="https://data.tmd.go.th/nwpapi/v1/forecast/location/hourly/at"
OPENMETEO_API_KEY=""
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"

# ------------------------------------------------------------------------------
# 3. BMA Civic Hazard & Flood Reports (Traffy Fondue Open API)
# Docs: https://publicapi.traffy.in.th/
# ------------------------------------------------------------------------------
TRAFFY_API_TOKEN=""
TRAFFY_API_BASE_URL="https://publicapi.traffy.in.th/teamchadchart-stat-api/geojson/v1"

# ------------------------------------------------------------------------------
# 4. FastAPI Serving, MLOps Control Plane & Alert Webhooks
# Used for X-API-Key header authentication on /api/v1/predict, /api/v1/config/keys,
# and /api/v1/mlops/rollback endpoints.
# ------------------------------------------------------------------------------
BKK_TRAFFIC_API_KEY="bkk-tactical-dev-key-2026"
API_HOST="127.0.0.1"
API_PORT="8050"
MLOPS_WEBHOOK_URL=""
LINE_NOTIFY_TOKEN=""

