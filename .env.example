# Bangkok Traffic MLOps Dashboard - Map API Keys
# Copy this file to `.env` and fill in either (or both) API keys.
# NEVER commit `.env` with real keys to Git!

# 1. Longdo Map API (FREE, no credit card): https://map.longdo.com/ -> My Longdo Map -> API
# Enables: iTIC Live Traffic Layer + Events (Accidents/Floods) + Bangkok CCTV Cameras + 500 Forecast Markers
LONGDO_MAP_API_KEY=""

# 2. Google Maps JavaScript API (Optional): https://console.cloud.google.com/
# Enables: Google Maps + Google Live Traffic Layer + 500 Forecast Markers
GOOGLE_MAPS_API_KEY=""

API_HOST="127.0.0.1"
API_PORT="8050"
